    {
      "parameters": {
        "jsCode": "// Sustituye este nodo por un nodo de IA (OpenAI, Anthropic, etc.) si quieres que un LLM reescriba el texto.\n// Recibe solo textos ya calculados por el backend: no hay datos personales ni transacciones.\nconst recos = $input.first().json.body?.recomendaciones ?? [];\nconst intro = { alta: 'Atención: ', media: 'Ojo: ', baja: 'Dato útil: ' };\nreturn [{ json: { recomendaciones: recos.map(r => ({ id: r.id, mensaje: `${intro[r.prioridad] ?? ''}${r.mensaje}` })) } }];"
      },
      "id": "a1f0c1c2-0002-4a00-9000-000000000002",

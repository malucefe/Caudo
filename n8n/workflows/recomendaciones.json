        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "a1f0c1c2-0003-4a00-9000-000000000003",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
